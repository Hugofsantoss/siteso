# Copie este arquivo para `.env` e ajuste os valores antes de rodar o projeto.

# Banco de dados (SQLite local por padrão — troque para Postgres/outro em produção
# ajustando também o adapter em src/lib/db.ts e o provider em prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Bootstrap do primeiro administrador (usado apenas por `prisma/seed.ts`, rodado uma vez).
# OBRIGATÓRIO trocar a senha antes de rodar em produção.
ADMIN_BOOTSTRAP_NAME="Administrador"
ADMIN_BOOTSTRAP_EMAIL="admin@solidoprediais.com.br"
ADMIN_BOOTSTRAP_PASSWORD="TrocarEssaSenha123!"

# Diretório de armazenamento local de uploads (fotos/vídeos/documentos das obras).
# Nunca fica dentro de /public — arquivos são servidos apenas por rota autenticada.
UPLOADS_DIR="./uploads"
