# Copie este arquivo para `.env` e ajuste os valores antes de rodar o projeto.
# Em produção (Vercel), configure estas mesmas variáveis em
# Project Settings → Environment Variables — nunca commite o `.env` real.

# ---------------------------------------------------------------------------
# Banco de dados — PostgreSQL via Supabase
# ---------------------------------------------------------------------------
# No painel da Supabase: Project Settings → Database → Connection string.
#
# DATABASE_URL: conexão via pooler (pgbouncer, "Transaction" mode, porta 6543).
# Usada em runtime pela aplicação (src/lib/db.ts) — obrigatório manter
# "?pgbouncer=true" no final para o modo transaction funcionar corretamente
# com ambientes serverless (Vercel).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: conexão direta (porta 5432, sem pooler). Usada apenas pelo CLI do
# Prisma (migrate/seed) — migrations precisam de uma conexão direta ao Postgres.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase Storage — armazenamento dos uploads (fotos/vídeos/documentos/capas)
# ---------------------------------------------------------------------------
# Project Settings → API. SUPABASE_SERVICE_ROLE_KEY é secreta — nunca prefixe
# com NEXT_PUBLIC_ e nunca exponha ao client; só é usada em código server-only
# (src/lib/storage.ts) para ler/escrever no bucket privado.
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"

# Nome do bucket privado onde os arquivos são armazenados (crie-o manualmente
# no painel: Storage → New bucket → "uploads", marcado como privado/não-público).
SUPABASE_STORAGE_BUCKET="uploads"

# ---------------------------------------------------------------------------
# Bootstrap do primeiro administrador (usado apenas por `prisma/seed.ts`, rodado uma vez)
# ---------------------------------------------------------------------------
# OBRIGATÓRIO trocar a senha antes de rodar em produção.
ADMIN_BOOTSTRAP_NAME="Administrador"
ADMIN_BOOTSTRAP_EMAIL="admin@solidoprediais.com.br"
ADMIN_BOOTSTRAP_PASSWORD="TrocarEssaSenha123!"
